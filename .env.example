IDPFORGE_ENV=production
IDPFORGE_LISTEN_ADDR=:8080
IDPFORGE_BASE_URL=https://sso.example.com

# postgres | mysql | mssql | sqlite
IDPFORGE_DB_DRIVER=postgres
IDPFORGE_DB_DSN=postgres://idpforge:changeme@localhost:5432/idpforge?sslmode=disable

IDPFORGE_REDIS_ENABLED=true
IDPFORGE_REDIS_ADDR=localhost:6379
IDPFORGE_REDIS_PASSWORD=

IDPFORGE_OIDC_ISSUER=https://sso.example.com
IDPFORGE_OIDC_SIGNING_KEY=

# none | turnstile | hcaptcha
IDPFORGE_CAPTCHA_PROVIDER=none
IDPFORGE_CAPTCHA_SITE_KEY=
IDPFORGE_CAPTCHA_SECRET_KEY=

IDPFORGE_BACKUP_ENABLED=false
IDPFORGE_BACKUP_DIR=
IDPFORGE_BACKUP_RETENTION_DAYS=14

# Password every admin-created account or admin-initiated reset gets, always
# paired with a forced change on next login. Never accepted or returned by
# any API besides this one config value (visible to admins in Settings).
IDPFORGE_DEFAULT_PASSWORD=

IDPFORGE_PASSWORD_EXPIRY_DAYS=0
IDPFORGE_PASSWORD_MIN_LENGTH=8
IDPFORGE_PASSWORD_REQUIRE_UPPERCASE=true
IDPFORGE_PASSWORD_REQUIRE_LOWERCASE=true
IDPFORGE_PASSWORD_REQUIRE_NUMBER=true
IDPFORGE_PASSWORD_REQUIRE_SPECIAL=true
